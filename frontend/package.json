{
  "name": "factordesk-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"uv run uvicorn factordesk.api.main:create_dev_app --factory --reload --reload-dir ../backend/factordesk --host 127.0.0.1 --port 8000\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "gen:types": "openapi-typescript src/api/openapi.json -o src/api/types.gen.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.108.0",
    "downshift": "9.5.0",
    "echarts": "6.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "31.0.1",
    "msw": "3.0.7",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=26",
    "npm": ">=12"
  }
}
