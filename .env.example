# Alpaca is not used in v1 (yfinance only); keys are placeholders for a later adapter.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_DATA_FEED=iex

# Multi-ticker price downloads (all optional; defaults shown). Yahoo publishes no rate limit,
# so keep these gentle. Raising workers or lowering the interval risks being rate limited.
PRICE_CHUNK_SIZE=5
PRICE_MAX_WORKERS=3
PRICE_MIN_INTERVAL_SECONDS=0.5
PRICE_MAX_ATTEMPTS=3
PRICE_BREAKER_THRESHOLD=3
