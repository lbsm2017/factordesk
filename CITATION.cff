url: "https://github.com/lbsm2017/factordesk"
license-url: "https://github.com/lbsm2017/factordesk/blob/prod/LICENSE"
keywords:
  - Fama-French
  - factor model
  - factor investing
  - asset pricing
  - portfolio analysis
  - risk attribution
  - performance attribution
  - value at risk
  - regression
  - Newey-West
